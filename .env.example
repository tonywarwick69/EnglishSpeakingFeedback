# MongoDB Atlas connection string
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database name (optional, defaults to "speaking_lab" if not set)
MONGODB_DB=speaking_lab

# Azure AI Speech (pronunciation assessment) — Free tier F0 is enough to start.
# Portal -> your Speech resource -> Resource Management -> Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=your-region
